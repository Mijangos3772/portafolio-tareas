[77.753671, "o", "\u001b[1;1H\u001b[1m\u001b[36m#!/bin/bash\u001b[m\u000f\u001b[2;1H\u001b[K\u001b[3;1H\u001b[1m\u001b[33mwhile true; do\u001b[m\u000f\u001b[3;15H\u001b[K\u001b[5;1H\u001b[1m\u001b[33mclear\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35m===== MENU PRINCIPAL =====\u001b[m\u000f\u001b[1m\u001b[33m\"\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35m1) crear arbol de directorios\u001b[m\u000f\u001b[1m\u001b[33m\"\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35m2) hola mundo\u001b[m\u000f\u001b[1m\u001b[33m\"\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35m3) saludo con variables\u001b[m\u000f\u001b[1m\u001b[33m\"\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35m4) salir\u001b[m\u000f\u001b[1m\u001b[33m\"\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35m==========================\u001b[m\u000f\u001b[1m\u001b[33m\"\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35mElige una opcion:\u001b[m\u000f\u001b[1m\u001b[33m\"\r\nread\u001b[m\u000f opcion\r\n\r\n\u001b[1m\u001b[33mcase\u001b[m\u000f \u001b[1m\u001b[34m$opcion\u001b[m\u000f \u001b[1m\u001b[33min\u001b[m\u000f\r\n1\u001b[1m\u001b[33m)\u001b[m\u000f\r\n./arbol.sh\r\n\u001b[1m\u001b[33mread\u001b[m\u000f \u001b[1m\u001b[31m-p\u001b[m\u000f \u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35mpresiona enter para continuar...\u001b[m\u000f\u001b[1m\u001b[33m\"\r\n;;\u001b[m\u000f\r\n2\u001b[1m\u001b[33m)\u001b[m\u000f\r\n./hola.sh\r\n\u001b[1m\u001b[33mread\u001b[m\u000f \u001b[1m\u001b[31m-p\u001b[m\u000f \u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35mpresiona enter para continuar...\u001b[m\u000f\u001b[1m\u001b[33m\"\r\n;;\u001b[m\u000f\r\n3\u001b[1m\u001b[33m)\u001b[m\u000f\r\n./saludo.sh\r\n\u001b[1m\u001b[33mread\u001b[m\u000f \u001b[1m\u001b[31m-p\u001b[m\u000f \u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35mpresiona enter para continuar...\u001b[m\u000f\u001b[1m\u001b[33m\"\r\n;;\u001b[m\u000f\r\n4\u001b[1m\u001b[33m)\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35msaliendo del programa...\u001b[m\u000f\u001b[1m\u001b[33m\"\r\nexit\u001b[m\u000f \u001b[1m\u001b[35m0\u001b[m\u000f\r\n\u001b[1m\u001b[33m;;\u001b[m\u000f\r\n*\u001b[1m\u001b[33m)\r\necho\u001b[m\u000f\u001b[1m\u001b[35m \u001b[m\u000f\u001b[1m\u001b[33m\"\u001b[m\u000f\u001b[1m\u001b[35mopcion no valida\u001b[m\u000f\u001b[1m\u001b[33m\"\r\nsleep\u001b[m\u000f \u001b[1m\u001b[35m2\u001b[m\u000f\r\n\u001b[1m\u001b[33m;;\r\nesac\r\n\r\ndone\u001b[m\u000f\r\n\u001b[1m\u001b[34m~                                                                                                                                                               \u001b[40;1H~                                                                                                                                                               \u001b[41;1H~                                                                                                                                                               \u001b[42;1H~                                                                                                                                                               \u001b[43;1H~                                                                                                                                                               \u001b[44;1H~                                                                                                                                                               \u001b[45;1H~                      